# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model id.
# Defaults to gemini-3.6-flash when unset.
GEMINI_MODEL=""

# GEMINI_TIMEOUT_MS: Optional per-request ceiling for a single Gemini call.
# Defaults to 12000 (kept below the browser client's 15s request timeout so the
# server fails first and the local-rule fallback can still answer).
GEMINI_TIMEOUT_MS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Environment Configuration
NODE_ENV="development"
PORT="3000"

# Data storage (Sprint 20) — exactly one of these modes is active:
#   PostgreSQL           DATABASE_URL is set. The database must be reachable or
#                        the server will not start (it never falls back to memory).
#                        The schema (server/db/schema.sql) is applied at startup.
#   Persistent embedded  the default when DATABASE_URL is not set. V2 data is
#                        kept in one JSON data file and survives restarts.
#   Temporary memory     PM_PORTAL_DATA_MODE="memory" (tests and demos only):
#                        nothing is saved; data is lost when the server stops.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pm_portal"
# In PostgreSQL mode the database is the only store: no demo data is seeded and
# a failed write is an error (503), never kept in memory. GET /api/v1/health is
# the readiness check (503 "degraded" when SELECT 1 fails); /api/v1/health/live
# is liveness only. `npm run test:pg` runs the live PostgreSQL test against
# DATABASE_URL in a temporary schema (use a disposable database); without
# DATABASE_URL it is skipped. `npm test` uses DATABASE_URL only for a database
# named *_test on this computer; for a remote one, confirm it is disposable with
# PM_PORTAL_TEST_DATABASE=<that database name>.

# PostgreSQL TLS. With NODE_ENV="production" the server certificate is verified.
# PM_PORTAL_DB_SSL_CA_FILE: path to the CA bundle for a private CA (also turns
# TLS on outside production). PM_PORTAL_DB_SSL_ALLOW_UNVERIFIED="true" skips
# certificate verification; use it only on a trusted network.
# TLS parameters in DATABASE_URL (sslmode, ssl, uselibpqcompat, sslrootcert,
# sslcert, sslkey) replace these settings: startup refuses them together with a
# CA file and, in production, refuses ones that turn TLS or verification off
# (e.g. sslmode=disable or no-verify) unless the opt-out above is set.
# PM_PORTAL_DB_SSL_CA_FILE=""
# PM_PORTAL_DB_SSL_ALLOW_UNVERIFIED=""

# Embedded data file location. Default: %LOCALAPPDATA%\PM-Portal\pm-portal-data.json
# on Windows, ~/.pm-portal/pm-portal-data.json elsewhere. It must be outside the
# application folder. It holds password hashes, encrypted tokens and all business
# data: protect it, and back it up by copying it while the server is stopped.
# PM_PORTAL_DATA_FILE=""
# PM_PORTAL_DATA_MODE="memory"

# First administrator for a new PostgreSQL database, or a new embedded store with
# NODE_ENV=production (which seeds no demo accounts). Used only while there is no
# active administrator; never changes an existing account. Outside production the
# embedded store is seeded with demo accounts whose passwords are in the source
# code: change or deactivate them before any real use.
# At least 12 characters mixing upper- and lower-case letters, digits and a
# symbol. Remove the password after the first start.
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD=""

# Authentication & Session Security (Cryptographic signing secret)
# With NODE_ENV="production" the server refuses to start unless JWT_SECRET is a
# random value of at least 32 characters (not this sample, not the built-in
# development default).
JWT_SECRET="enterprise_super_secret_jwt_key_surya_pm_portal_v2"
# Session lifetime for the token and the HttpOnly cookie: a whole number with an
# optional unit (s, m, h, d; no unit means seconds), from 1 minute to 90 days.
SESSION_EXPIRY="7d"

# Network address the server listens on (Sprint 22A). While JWT_SECRET is not a
# private random value of at least 32 characters (missing, the development
# default, or the sample above), the portal listens on this computer only
# (127.0.0.1) and refuses a non-local address, because anyone who can reach it
# could forge a sign-in with a known secret. With a private JWT_SECRET it
# listens on every interface (0.0.0.0) unless this is set.
# PM_PORTAL_HOST=""
#
# Host names (comma-separated) the server answers for besides localhost, the APP_URL,
# CORS_ALLOWED_ORIGINS and MICROSOFT_REDIRECT_URI hosts and - when listening on every
# interface - this computer's name and addresses; any other Host header gets 421
# (a DNS-rebinding defence). Add the LAN or DNS name users type, e.g. "pm.company.lan".
# PM_PORTAL_ALLOWED_HOSTS=""

# Browser origins (besides the portal's own address) allowed to call the API
# with credentials, comma-separated, e.g. "https://pm.example.com". Outside
# production http://localhost:<PORT> and http://127.0.0.1:<PORT> are allowed too.
CORS_ALLOWED_ORIGINS=""

# Failed sign-in limit: attempts per account and address within the window
# (defaults 5 and 900000 ms = 15 minutes; an address is limited at 4x across accounts).
LOGIN_RATE_LIMIT_MAX=""
LOGIN_RATE_LIMIT_WINDOW_MS=""

# Microsoft 365 / Outlook integration (Sprints 10A-10B, optional)
# Lets a signed-in portal user connect their Microsoft 365 account so the
# server can read their Outlook calendar and send email they explicitly
# confirm. This is NOT a portal login.
# Register a Web (confidential) app in Microsoft Entra ID with delegated Graph
# permissions: openid, profile, email, offline_access, User.Read,
# Calendars.Read, Mail.Send. Some tenants require admin consent for Mail.Send.
# Connections made before Mail.Send was added keep working for the calendar;
# users reconnect from Settings to enable Outlook sending.
# The integration stays disabled ("not configured") until the client id,
# client secret AND token encryption key are all set.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" allows work/school and personal accounts; use "organizations" or a
# specific tenant id to restrict who can connect.
MICROSOFT_TENANT_ID="common"
# Must exactly match the redirect URI registered on the Entra app, using the
# host and port the portal is actually served from.
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/v1/auth/microsoft/callback"
# 32-byte key for AES-256-GCM encryption of stored OAuth tokens: 64 hex
# characters, e.g. generated with `openssl rand -hex 32`. There is no default
# key. Changing it invalidates stored connections (users must reconnect).
MICROSOFT_TOKEN_ENCRYPTION_KEY=""
# Optional timeout for a single Microsoft request, in milliseconds (default 10000).
MICROSOFT_GRAPH_TIMEOUT_MS=""

# Jira issue links (Sprint 15A, optional)
# The https base URL of your Jira, e.g. "https://company.atlassian.net" or a
# self-hosted "https://jira.example.com". With it, a Jira key such as PROJ-123
# links to <base>/browse/PROJ-123, and links on that host are recognised.
# Links on *.atlassian.net and *.jira.com are recognised without it. The
# portal never calls Jira: there are no Jira credentials or tokens.
JIRA_BASE_URL=""
