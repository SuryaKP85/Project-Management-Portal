# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model id.
# Defaults to gemini-3.6-flash when unset.
GEMINI_MODEL=""

# GEMINI_TIMEOUT_MS: Optional per-request ceiling for a single Gemini call.
# Defaults to 12000 (kept below the browser client's 15s request timeout so the
# server fails first and the local-rule fallback can still answer).
GEMINI_TIMEOUT_MS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Environment Configuration
NODE_ENV="development"
PORT="3000"

# Database Configuration (PostgreSQL connection string)
# If not provided, the server uses a resilient in-memory SQLite/relational mock store for standalone local dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pm_portal"

# Authentication & Session Security (Cryptographic signing secret)
JWT_SECRET="enterprise_super_secret_jwt_key_surya_pm_portal_v2"
SESSION_EXPIRY="7d"

# Microsoft 365 / Outlook integration (Sprints 10A-10B, optional)
# Lets a signed-in portal user connect their Microsoft 365 account so the
# server can read their Outlook calendar and send email they explicitly
# confirm. This is NOT a portal login.
# Register a Web (confidential) app in Microsoft Entra ID with delegated Graph
# permissions: openid, profile, email, offline_access, User.Read,
# Calendars.Read, Mail.Send. Some tenants require admin consent for Mail.Send.
# Connections made before Mail.Send was added keep working for the calendar;
# users reconnect from Settings to enable Outlook sending.
# The integration stays disabled ("not configured") until the client id,
# client secret AND token encryption key are all set.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" allows work/school and personal accounts; use "organizations" or a
# specific tenant id to restrict who can connect.
MICROSOFT_TENANT_ID="common"
# Must exactly match the redirect URI registered on the Entra app, using the
# host and port the portal is actually served from.
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/v1/auth/microsoft/callback"
# 32-byte key for AES-256-GCM encryption of stored OAuth tokens: 64 hex
# characters, e.g. generated with `openssl rand -hex 32`. There is no default
# key. Changing it invalidates stored connections (users must reconnect).
MICROSOFT_TOKEN_ENCRYPTION_KEY=""
# Optional timeout for a single Microsoft request, in milliseconds (default 10000).
MICROSOFT_GRAPH_TIMEOUT_MS=""

# Jira issue links (Sprint 15A, optional)
# The https base URL of your Jira, e.g. "https://company.atlassian.net" or a
# self-hosted "https://jira.example.com". With it, a Jira key such as PROJ-123
# links to <base>/browse/PROJ-123, and links on that host are recognised.
# Links on *.atlassian.net and *.jira.com are recognised without it. The
# portal never calls Jira: there are no Jira credentials or tokens.
JIRA_BASE_URL=""
